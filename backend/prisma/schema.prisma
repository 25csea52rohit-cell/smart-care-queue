datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        // PATIENT | RECEPTIONIST | DOCTOR | ADMIN
  phone        String?
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String
  doctors     DoctorProfile[]
  appointments Appointment[]
  queueTickets QueueTicket[]
}

model Room {
  id              String   @id @default(uuid())
  number          String   @unique // 101, 201, 301, 401
  wing            String   // Emergency Wing, Pediatrics, Orthopedics, General OPD
  floor           Int
  categoryAllowed String   // EMERGENCY | URGENT | PRIORITY | GENERAL
  status          String   @default("AVAILABLE") // AVAILABLE | BUSY | MAINTENANCE | OFFLINE
  
  doctors         DoctorProfile[]
  queueTickets    QueueTicket[]
}

model DoctorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty         String
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  roomId            String?
  room              Room?      @relation(fields: [roomId], references: [id])
  isAvailable       Boolean    @default(true)
  maxPatientsPerDay Int        @default(30)

  appointments      Appointment[]
  queueTickets      QueueTicket[]
}

model PatientProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age              Int?
  medicalHistory   String?
  emergencyContact String?
}

model Appointment {
  id            String   @id @default(uuid())
  patientId     String
  patientName   String
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  departmentId  String
  department    Department    @relation(fields: [departmentId], references: [id])
  scheduledTime DateTime
  symptoms      String
  category      String   // EMERGENCY | URGENT | PRIORITY | GENERAL
  status        String   @default("SCHEDULED") // SCHEDULED | CHECKED_IN | CANCELLED | COMPLETED
  ticketId      String?
  createdAt     DateTime @default(now())
}

model QueueTicket {
  id                   String    @id @default(uuid())
  ticketNumber         String    // E-001, U-002, P-001, G-010
  patientId            String
  patientName          String
  patientAge           Int?
  category             String    // EMERGENCY | URGENT | PRIORITY | GENERAL
  symptoms             String
  priorityScore        Int       @default(0)
  status               String    @default("WAITING") // WAITING | CALLED | IN_CONSULTATION | COMPLETED | CANCELLED
  departmentId         String
  department           Department @relation(fields: [departmentId], references: [id])
  doctorId             String?
  doctor               DoctorProfile? @relation(fields: [doctorId], references: [id])
  roomId               String?
  room                 Room?     @relation(fields: [roomId], references: [id])
  estimatedWaitMinutes Int       @default(15)
  positionInLine       Int       @default(1)
  qrCodeUrl            String?
  createdAt            DateTime  @default(now())
  calledAt             DateTime?
  completedAt          DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | EMERGENCY
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  details   String
  createdAt DateTime @default(now())
}
